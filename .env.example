# =============================================================================
# Run tests (required to clone and run Playwright)
# Copy this file to `.env` and replace placeholders. Never commit `.env`.
# =============================================================================

# Base URL of the Didaxis Studio environment under test
DIDAXIS_URL=https://test.didaxis.studio

# Admin account used by auth setup and most specs
DIDAXIS_EMAIL=admin@example.com

# Password for the admin account
DIDAXIS_PASSWORD=your_admin_password

# Bearer token for API cleanup (DELETE /api/programs); falls back to login if unset
DIDAXIS_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.payload.signature

# Optional — non-admin / alt account for permission-probe specs (access-denied flows)
DIDAXIS_ALT_EMAIL=alt_user@example.com

# Optional — password for the alt / permission-probe account
DIDAXIS_ALT_PASSWORD=your_alt_password

# =============================================================================
# Agent / CI setup (not needed for `npx playwright test` alone)
# Used by the headless agent in `.github/workflows/test-generation.yml`
# and Atlassian MCP in Cursor settings — not read by Playwright directly.
# =============================================================================

# Cursor CLI API key for headless agent runs in GitHub Actions
CURSOR_API_KEY=cur_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Atlassian Cloud API token (Jira / Confluence MCP)
ATLASSIAN_API_TOKEN=ATATTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Atlassian site base URL (e.g. https://your-org.atlassian.net)
ATLASSIAN_BASE_URL=https://your-org.atlassian.net

# Email tied to the Atlassian API token
ATLASSIAN_EMAIL=you@example.com
