{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/generation-gate.js",
        "matcher": "tests/.*|Write|TabWrite",
        "failClosed": true
      },
      {
        "command": ".cursor/hooks/assertion-guard.js",
        "matcher": "tests/",
        "failClosed": true
      }
    ]
  }
}
